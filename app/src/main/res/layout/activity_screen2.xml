<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <ImageView
        android:id="@+id/iv1"
        android:layout_width="match_parent"
        android:layout_height="150sp"
        android:src="@drawable/image_addition"
        android:translationY="-25dp"

        />

    <TextView
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/tv3"
        android:layout_marginHorizontal="50dp"
        android:layout_marginBottom="34dp"
        android:text="Sign Up"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv2"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Sign In"
        android:layout_toRightOf="@id/tv1"
        android:layout_marginBottom="34dp"
        android:layout_marginHorizontal="70dp"
        android:textColor="@color/white"
        android:layout_above="@id/tv3"
        android:textSize="18sp"
        />

    <TextView
        android:id="@+id/tv3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iv1"
        android:layout_marginHorizontal="95dp"
        android:text="Welcome Back!"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        />
    <EditText
        android:id="@+id/etv1"
        android:layout_width="300dp"
        android:layout_height="40sp"
        android:layout_below="@+id/tv3"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/edit_text_border"
        android:drawableStart="@drawable/email_logo"
        android:drawablePadding="20sp"
        android:hint="E-mail "
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/black"
        android:textColorHint="@color/black"

        />
    <EditText
        android:id="@+id/etv2"
        android:layout_width="300dp"
        android:layout_height="40sp"
        android:layout_below="@+id/etv1"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/edit_text_border"
        android:drawableStart="@drawable/lock_logo"
        android:drawableEnd="@drawable/visibility_off_logo"
        android:paddingEnd="20dp"
        android:drawablePadding="20sp"
        android:hint="Password"
        android:paddingStart="20dp"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        />

    <CheckBox
        android:id="@+id/cb1"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_below="@id/etv2"
        android:layout_marginTop="10sp"
        android:layout_marginStart="30dp"

        />

    <TextView
        android:id="@+id/tv4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/etv2"
        android:layout_toRightOf="@+id/cb1"
        android:layout_marginTop="10sp"
        android:textColor="@color/black"
        android:text="Remember Password"
        />

    <TextView
        android:id="@+id/tv5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/etv2"
        android:layout_toRightOf="@id/tv4"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="10dp"
        android:hint="Forget Password ?"
        android:textColorHint="#ff0000" />

    <Button
        android:id="@+id/bt1"
        android:layout_width="267dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv5"
        android:layout_marginHorizontal="45dp"
        android:layout_marginTop="21dp"
        android:hint="Sign In"
        android:textColorHint="@color/white" />
    <TextView
        android:id="@+id/tv6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="--Or Sign In With--"
        android:textColorHint="@color/black"
        android:layout_below="@+id/bt1"
        android:layout_marginHorizontal="110dp"
        android:layout_marginTop="20dp"
        android:textSize="14sp"
        android:textStyle="bold"
        />
    <Button
        android:id="@+id/bt2"
        android:layout_below="@+id/tv6"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/google_logo"
        android:layout_marginHorizontal="25dp"
        android:hint="google"
        android:layout_marginTop="15dp"
        android:textColorHint="@color/white" />

    <Button
        android:id="@+id/bt3"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv6"
        android:layout_marginTop="17dp"
        android:layout_toEndOf="@id/bt2"
        android:drawableLeft="@drawable/facebook_logo_1_2"
        android:hint="Facebook"
        android:textColorHint="@color/white" />

    <ImageView
        android:id="@+id/iv2"
        android:layout_below="@+id/bt3"
        android:layout_width="match_parent"
        android:layout_height="150sp"
        android:src="@drawable/image_addition"
        android:translationY="130dp"
        />

</RelativeLayout>